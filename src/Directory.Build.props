<Project>

<PropertyGroup>
  <!-- Common Build Properties -->
  <LangVersion>latest</LangVersion>
  <TargetFramework>net10.0</TargetFramework>
  <Nullable>enable</Nullable>
  <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  <WarningLevel>9999</WarningLevel>
  <EnableNETAnalyzers>true</EnableNETAnalyzers>
  <AnalysisLevel>latest</AnalysisLevel>
  <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

  <!-- Centralized Version Management -->
  <!-- Version can be overridden via command line: dotnet build /p:Version=1.0.0 -->
  <!-- Or via environment variable in CI/CD: VERSION=1.0.0 -->
  <VersionPrefix Condition="'$(VersionPrefix)' == ''">0.0.7</VersionPrefix>
  <VersionSuffix Condition="'$(VersionSuffix)' == ''">alpha</VersionSuffix>
    
  <!-- Construct the full version -->
  <Version Condition="'$(Version)' == '' AND '$(VersionSuffix)' != ''">$(VersionPrefix)-$(VersionSuffix)</Version>
  <Version Condition="'$(Version)' == '' AND '$(VersionSuffix)' == ''">$(VersionPrefix)</Version>
    
  <!-- Assembly versioning (without suffix for compatibility) -->
  <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">$(VersionPrefix).0</AssemblyVersion>
  <FileVersion Condition="'$(FileVersion)' == ''">$(VersionPrefix).0</FileVersion>

  <!-- Package Metadata -->
  <Authors>OakIdeas</Authors>
  <Company>OakIdeas</Company>
  <Copyright>OakIdeas</Copyright>
  <PackageProjectUrl>https://github.com/oakcool/OakIdeas.GenericRepository</PackageProjectUrl>
  <RepositoryUrl>https://github.com/oakcool/OakIdeas.GenericRepository</RepositoryUrl>
  <RepositoryType>git</RepositoryType>
  <NeutralLanguage>en-US</NeutralLanguage>
  <PackageIcon>GenericRepository.png</PackageIcon>
  <PackageReadmeFile>README.md</PackageReadmeFile>

  <!-- Deterministic Build -->
  <Deterministic>true</Deterministic>
  <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

  <!-- Source Link -->
  <PublishRepositoryUrl>true</PublishRepositoryUrl>
  <EmbedUntrackedSources>true</EmbedUntrackedSources>
  <IncludeSymbols>true</IncludeSymbols>
  <SymbolPackageFormat>snupkg</SymbolPackageFormat>
</PropertyGroup>

  <!-- Enable ImplicitUsings for non-test projects -->
  <PropertyGroup Condition="'$(IsTestProject)' != 'true'">
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Common Package Files for Packable Projects -->
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)..\LICENSE" Pack="true" PackagePath="" Visible="false" />    
    <None Include="$(MSBuildThisFileDirectory)..\Images\GenericRepository.png" Pack="true" PackagePath="" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="" Visible="false" Condition="Exists('$(MSBuildThisFileDirectory)..\README.md')" />
  </ItemGroup>

  <!-- Source Link Package Reference -->
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.201" PrivateAssets="All" />
  </ItemGroup>

  <PropertyGroup>
      <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
